# Copy this file to .env for local development. Never commit .env.

# Realtime server (defaults shown)
# PORT=3001
# CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL 13 or later) -------------------------------------
# Required. Without it the server still starts, but /ready reports not ready.
# Carries credentials: never log it or return it in a response.
DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard

# Connections this instance may hold. A cluster-wide budget: this multiplied by
# the number of instances must stay inside the server's max_connections. Put a
# connection pooler in front rather than raising it.
# DATABASE_POOL_MAX=10

# Milliseconds. Connection timeout fails a request instead of queueing it
# forever; statement timeout stops a runaway query holding a connection.
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=10000

# TLS to the database: disable (default), require, or no-verify.
# "require" verifies the certificate. "no-verify" encrypts without verifying and
# is only for providers that present a self-signed certificate.
# Only when DATABASE_URL names no sslmode: setting both stops startup, because
# the URL would silently win (finding F-23). Managed providers (Neon) put
# sslmode in the URL; use sslmode=verify-full there and leave this unset.
# DATABASE_SSL=require

# Names this process in pg_stat_activity.
# DATABASE_APPLICATION_NAME=flowboard

# A throwaway database for the schema integration tests. These are skipped
# unless it is set, and the database is emptied on every run.
# TEST_DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard_test

# --- Security headers -------------------------------------------------------
# How long a browser should refuse to reach this API over plain HTTP, in
# seconds. Default 15552000 (180 days). Set to 0 to omit the header entirely,
# for a deployment not behind TLS yet.
#
# Sent with includeSubDomains, and never with preload: preloading is
# effectively irreversible and should be a separate, deliberate choice.
# SECURITY_HSTS_MAX_AGE_SECONDS=15552000

# --- Authentication ---------------------------------------------------------
# Signup and sign-in attempts per client per minute; 0 turns the limit off.
#
# Deliberately lower than the AI limit: each attempt costs an Argon2 hash, and a
# burst can occupy the libuv threadpool and delay unrelated work on the instance.
# Interim — the counters are per-process, so the real limit across N instances is
# N times this. Behind a reverse proxy, enable Express's `trust proxy` so the
# limit sees real client addresses.
# AUTH_RATE_LIMIT_PER_MINUTE=5

# Refresh, sign-out and "who am I" requests per client per minute; 0 turns it
# off. Generous, because tabs make them routinely and none costs a hash.
# Counted in PostgreSQL, so it holds across instances.
# AUTH_SESSION_RATE_LIMIT_PER_MINUTE=60

# Consecutive failed sign-ins against one address before each further attempt
# must wait: 1 minute, doubling, capped at 15. 0 turns the backoff off.
# AUTH_LOGIN_BACKOFF_THRESHOLD=5

# Cloudflare Turnstile on signup (bot protection). Server-side secret; set
# together with VITE_TURNSTILE_SITE_KEY on the web app, or signup refuses
# every request for want of a token. Unset turns the check off.
# Test key that always passes: 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=

# Sessions revoked or expired longer ago than this are deleted, with their
# refresh tokens (1-365 days, default 30). Checked once per this many sign-ins
# and refreshes per process.
# AUTH_SESSION_RETENTION_DAYS=30
# AUTH_SESSION_PURGE_EVERY=200

# Argon2id cost for password hashing. Defaults are OWASP's 2024 baseline.
#
# Raising these strengthens stored passwords and lowers how many logins an
# instance can serve per second: roughly 40-50/s at the defaults, bounded by the
# libuv threadpool. Tune against real hardware, and raise UV_THREADPOOL_SIZE
# before raising these. Each hash records the parameters it was made with, so a
# change upgrades existing accounts on their next successful login.
# AUTH_ARGON2_MEMORY_KIB=19456
# AUTH_ARGON2_TIME_COST=2
# AUTH_ARGON2_PARALLELISM=1

# Keys that sign and verify access tokens (JWT, HS256). Required once the auth
# routes issue tokens. Server-side only: anyone holding a key can sign in as
# anyone, so treat it exactly like DATABASE_URL.
#
# A comma-separated list of id:secret. The secret is base64url, at least 32
# random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The first key signs and every key verifies. To rotate, put the new key first,
# keep the old one second for one token lifetime, then remove it.
# A malformed value stops the server at startup; it never falls back.
AUTH_ACCESS_TOKEN_KEYS=

# How long an access token lives, in seconds. 60-3600; default 900 (15 minutes).
# This is also how long a "sign out everywhere" takes to reach every device.
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh tokens. Idle: a token not used for this long is dead (3600-7776000,
# default 1209600 = 14 days). Session: the absolute limit on one sign-in, never
# extended by use (3600-31536000, default 2592000 = 30 days).
# AUTH_REFRESH_IDLE_TTL_SECONDS=1209600
# AUTH_SESSION_TTL_SECONDS=2592000

# Seconds after a refresh token is exchanged during which presenting it again
# is taken as two tabs racing, or a retried request, rather than theft
# (0-60, default 20). Past it, a replay revokes the whole session.
# AUTH_REFRESH_REUSE_GRACE_SECONDS=20

# The refresh cookie is HttpOnly and sent only to /api/auth.
#
# Secure is on unless this says exactly "false". Turn it off only for local
# development over plain http; the cookie is then named flowboard_refresh
# instead of __Secure-flowboard_refresh.
# AUTH_COOKIE_SECURE=false
#
# strict (default), lax, or none. The web app and the API must be on the same
# site (e.g. app.example.com and api.example.com, or the API proxied under the
# app's domain) for strict to work. "none" is for a cross-site deployment and is
# blocked outright by Safari, so treat it as a stopgap. See AUTH_DECISIONS.md E-15.
# AUTH_COOKIE_SAME_SITE=strict

# Production only: the secret Vercel's route adds to every /api/auth request
# (Frontend/vercel.json), which proves the client address Vercel reports can be
# trusted. Set the same value on Vercel. With it set, auth requests without it
# are refused; leave it unset in development. 32+ random bytes as base64url
# (the same command as the signing key). See docs/DEPLOYMENT.md.
# AUTH_PROXY_SECRET=

# --- AI diagram generation --------------------------------------------------
# Server-side only: never put these in the frontend.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Requests per client per minute; 0 turns the limit off.
# AI_RATE_LIMIT_PER_MINUTE=10
