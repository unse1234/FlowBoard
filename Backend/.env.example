# Copy this file to .env for local development. Never commit .env.

# Realtime server (defaults shown)
# PORT=3001
# CLIENT_ORIGIN=http://localhost:5173

# AI diagram generation. Server-side only: never put these in the frontend.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Requests per client per minute; 0 turns the limit off.
# AI_RATE_LIMIT_PER_MINUTE=10
